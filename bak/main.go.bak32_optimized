// ---- Helpers ----
func log(msg string) {
	js.Global().Get("console").Call("log", msg)
}

func sign(x float64) float64 {
	if x > 0 {
		return 1
	}
	if x < 0 {
		return -1
	}
	return 0
}

func abs(x int) int {
	if x < 0 {
		return -x
	}
	return x
}

func showStatus(text string, duration float64) {
	statusMessages = append(statusMessages, statusMessage{text: text, timer: duration})
	if len(statusMessages) > 3 {
		statusMessages = statusMessages[len(statusMessages)-3:]
	}
}

func gridKey(row, col int) int {
	return row*gridCols + col
}

func registerBrick(index int) {
	br := &bricks[index]
	brickGrid[gridKey(br.row, br.col)] = append(brickGrid[gridKey(br.row, br.col)], index)
	if !br.unbreakable {
		remainingBreakableBricks++
	}
}

func destroyBrick(br *brick) bool {
	if br == nil || !br.alive || br.unbreakable {
		return false
	}
	br.alive = false
	score++
	remainingBreakableBricks--
	if remainingBreakableBricks < 0 {
		remainingBreakableBricks = 0
	}
	bricksDirty = true
	return true
}

func destroyAnyBrick(br *brick) bool {
	if br == nil || !br.alive {
		return false
	}
	br.alive = false
	score++
	if !br.unbreakable {
		remainingBreakableBricks--
		if remainingBreakableBricks < 0 {
			remainingBreakableBricks = 0
		}
	}
	bricksDirty = true
	return true
}

func updateHUDCache() {
	level := currentLevelIndex + 1
	if hudLivesValue != lives {
		hudLivesValue = lives
		hudLivesText = "Lives: " + strconv.Itoa(lives)
	}
	if hudLevelValue != level {
		hudLevelValue = level
		hudLevelText = "Level: " + strconv.Itoa(level)
	}
	if hudScoreValue != score {
		hudScoreValue = score
		hudScoreText = "Score: " + strconv.Itoa(score)
	}
}

// ---- Audio (non-blocking, scheduled via Web Audio) ----
func initAudio() {
	if audioInitialized || !enableSounds {
		return
	}

	defer func() {
		if r := recover(); r != nil {
			audioInitialized = false
			audioCtx = js.Undefined()
			js.Global().Get("console").Call("error", "Audio init panic:", fmt.Sprint(r))
		}
	}()

	window := js.Global().Get("window")
	ctor := window.Get("AudioContext")
	if ctor.IsUndefined() || ctor.IsNull() {
		ctor = window.Get("webkitAudioContext")
	}
	if ctor.IsUndefined() || ctor.IsNull() {
		log("Web Audio API is not supported by this browser")
		return
	}

	ctx := ctor.New()
	if ctx.IsUndefined() || ctx.IsNull() {
		log("Failed to create AudioContext")
		return
	}

	audioCtx = ctx
	audioInitialized = true

	// AudioContext.resume() returns a Promise. It does not need to be awaited
	// here because this function is called directly from a user keypress.
	if state := audioCtx.Get("state"); state.Type() == js.TypeString && state.String() == "suspended" {
		audioCtx.Call("resume")
	}

	log("Audio initialized")
}

func scheduleBeep(freq float64, duration float64, volume float64, delay float64) {
	if !audioInitialized || !enableSounds || audioCtx.IsNull() || audioCtx.IsUndefined() {
		return
	}
	defer func() {
		if r := recover(); r != nil {
			// Ignore audio errors silently
		}
	}()
	startTime := audioCtx.Get("currentTime").Float() + delay
	osc := audioCtx.Call("createOscillator")
	gain := audioCtx.Call("createGain")
	osc.Set("type", "sine")
	osc.Set("frequency", freq)
	gain.Set("gain", volume)
	osc.Call("connect", gain)
	gain.Call("connect", audioCtx.Get("destination"))
	osc.Call("start", startTime)
	gain.Get("gain").Call("exponentialRampToValueAtTime", 0.001, startTime+duration)
	osc.Call("stop", startTime+duration+0.05)
}

func playBeep(freq float64, duration float64, volume float64) {
	scheduleBeep(freq, duration, volume, 0)
}

