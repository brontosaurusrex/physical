//go:build js && wasm

package main

import (
	"math"
	"syscall/js"
)

const (
	canvasWidth     = 800.0
	canvasHeight    = 600.0
	gravity         = 200.0
	restitution     = 0.92
	frictionCoeff   = 0.3
	paddleWidth     = 80.0
	paddleHeight    = 12.0
	ballRadius      = 10.0
	brickRows       = 5
	brickCols       = 8
	brickWidth      = 70.0
	brickHeight     = 20.0
	brickPadding    = 10.0
	brickOffsetTop  = 50.0
	brickOffsetLeft = 35.0

	// ***** INCREASED BOOST *****
	paddleBoost = 300.0 // now adds a LOT of energy
	maxSpeed    = 800.0 // optional speed cap
)

var (
	doc    = js.Global().Get("document")
	canvas js.Value
	ctx    js.Value

	ball = struct {
		x, y, r      float64
		vx, vy       float64
		omega, angle float64
	}{
		x:     400,
		y:     300,
		r:     ballRadius,
		vx:    180,
		vy:    -350,
		omega: 0,
		angle: 0,
	}

	paddle = struct {
		x, y, w, h float64
		vx         float64
	}{
		x:  (canvasWidth - paddleWidth) / 2,
		y:  canvasHeight - 40,
		w:  paddleWidth,
		h:  paddleHeight,
		vx: 0,
	}

	bricks   []brick
	score    int
	lives    int
	gameOver bool

	lastTime float64

	loopFunc   js.Func
	keyDown    js.Func
	keyUp      js.Func
	mouseMove  js.Func
	mouseLeave js.Func
)

type brick struct {
	x, y, w, h float64
	alive      bool
}

func log(msg string) {
	js.Global().Get("console").Call("log", msg)
}

func sign(x float64) float64 {
	if x > 0 {
		return 1
	}
	if x < 0 {
		return -1
	}
	return 0
}

func resolveCollision(nx, ny, surfVx, surfVy float64) {
	cx := ball.x + nx*ball.r
	cy := ball.y + ny*ball.r
	contactVx := ball.vx - ball.omega*(cy-ball.y)
	contactVy := ball.vy + ball.omega*(cx-ball.x)
	relVx := contactVx - surfVx
	relVy := contactVy - surfVy
	vn := relVx*nx + relVy*ny
	vt := relVx*(-ny) + relVy*nx
	if vn >= 0 {
		return
	}
	vnNew := -restitution * vn
	deltaVn := vnNew - vn
	maxFriction := frictionCoeff * math.Abs(deltaVn)
	var deltaVt float64
	if math.Abs(vt) < 0.001 {
		deltaVt = -vt
	} else {
		friction := math.Min(math.Abs(vt), maxFriction)
		deltaVt = -sign(vt) * friction
	}
	tx := -ny
	ty := nx
	ball.vx += deltaVn*nx + deltaVt*tx
	ball.vy += deltaVn*ny + deltaVt*ty
	ball.omega += 2 * deltaVt / ball.r
}

func initBricks() {
	bricks = nil
	for row := 0; row < brickRows; row++ {
		for col := 0; col < brickCols; col++ {
			x := brickOffsetLeft + float64(col)*(brickWidth+brickPadding)
			y := brickOffsetTop + float64(row)*(brickHeight+brickPadding)
			bricks = append(bricks, brick{x: x, y: y, w: brickWidth, h: brickHeight, alive: true})
		}
	}
}

func resetGame() {
	ball.x, ball.y = 400, 300
	ball.vx, ball.vy = 180, -350
	ball.omega, ball.angle = 0, 0
	paddle.x = (canvasWidth - paddleWidth) / 2
	paddle.vx = 0
	score = 0
	lives = 3
	gameOver = false
	initBricks()
	log("Game reset")
}

func update(dt float64) {
	if gameOver {
		return
	}
	ball.vy += gravity * dt
	ball.x += ball.vx * dt
	ball.y += ball.vy * dt
	ball.angle += ball.omega * dt

	if ball.x-ball.r < 0 {
		ball.x = ball.r
		resolveCollision(1, 0, 0, 0)
	}
	if ball.x+ball.r > canvasWidth {
		ball.x = canvasWidth - ball.r
		resolveCollision(-1, 0, 0, 0)
	}
	if ball.y-ball.r < 0 {
		ball.y = ball.r
		resolveCollision(0, 1, 0, 0)
	}
	if ball.y+ball.r > canvasHeight {
		lives--
		if lives <= 0 {
			gameOver = true
		} else {
			ball.x, ball.y = 400, 300
			ball.vx, ball.vy = 180, -350
			ball.omega, ball.angle = 0, 0
			paddle.x = (canvasWidth - paddleWidth) / 2
			paddle.vx = 0
		}
		return
	}

	pLeft, pRight := paddle.x, paddle.x+paddle.w
	pTop, pBottom := paddle.y, paddle.y+paddle.h
	if ball.vy > 0 &&
		ball.x+ball.r > pLeft && ball.x-ball.r < pRight &&
		ball.y+ball.r > pTop && ball.y+ball.r < pBottom {
		ball.y = pTop - ball.r
		resolveCollision(0, -1, paddle.vx, 0)
		// ***** BIG ENERGY BOOST *****
		ball.vy -= paddleBoost
		// Optional speed cap (keeps it from going too fast)
		if math.Abs(ball.vy) > maxSpeed {
			ball.vy = math.Copysign(maxSpeed, ball.vy)
		}
		if math.Abs(ball.vx) > maxSpeed {
			ball.vx = math.Copysign(maxSpeed, ball.vx)
		}
	}

	for i := range bricks {
		b := &bricks[i]
		if !b.alive {
			continue
		}
		if ball.x+ball.r > b.x && ball.x-ball.r < b.x+b.w &&
			ball.y+ball.r > b.y && ball.y-ball.r < b.y+b.h {
			overlapX := math.Min(ball.x+ball.r-b.x, b.x+b.w-(ball.x-ball.r))
			overlapY := math.Min(ball.y+ball.r-b.y, b.y+b.h-(ball.y-ball.r))
			var nx, ny float64
			if overlapX < overlapY {
				nx = 1.0
				if ball.x > b.x+b.w/2 {
					nx = -1.0
				}
			} else {
				ny = 1.0
				if ball.y > b.y+b.h/2 {
					ny = -1.0
				}
			}
			if nx != 0 {
				ball.x += nx * (overlapX + 0.1)
			}
			if ny != 0 {
				ball.y += ny * (overlapY + 0.1)
			}
			resolveCollision(nx, ny, 0, 0)
			b.alive = false
			score++
			speed := math.Sqrt(ball.vx*ball.vx + ball.vy*ball.vy)
			if speed < 700 {
				ball.vx *= 1.05
				ball.vy *= 1.05
			}
		}
	}
}

func draw() {
	ctx.Call("clearRect", 0, 0, canvasWidth, canvasHeight)

	for _, b := range bricks {
		if !b.alive {
			continue
		}
		ctx.Set("fillStyle", "#2ecc71")
		ctx.Call("fillRect", b.x, b.y, b.w, b.h)
		ctx.Set("strokeStyle", "#27ae60")
		ctx.Set("lineWidth", 1)
		ctx.Call("strokeRect", b.x, b.y, b.w, b.h)
	}

	ctx.Call("save")
	ctx.Call("translate", ball.x, ball.y)
	ctx.Call("rotate", ball.angle)
	ctx.Set("fillStyle", "#e74c3c")
	ctx.Call("beginPath")
	ctx.Call("arc", 0, 0, ball.r, 0, 2*math.Pi)
	ctx.Call("fill")
	ctx.Set("strokeStyle", "white")
	ctx.Set("lineWidth", 2)
	ctx.Call("beginPath")
	ctx.Call("moveTo", 0, -ball.r)
	ctx.Call("lineTo", 0, ball.r)
	ctx.Call("stroke")
	ctx.Set("fillStyle", "white")
	ctx.Call("beginPath")
	ctx.Call("arc", 0, 0, 2, 0, 2*math.Pi)
	ctx.Call("fill")
	ctx.Call("restore")

	ctx.Set("fillStyle", "#3498db")
	ctx.Call("fillRect", paddle.x, paddle.y, paddle.w, paddle.h)

	ctx.Set("fillStyle", "#ecf0f1")
	ctx.Set("font", "20px sans-serif")
	ctx.Call("fillText", "Score: "+js.ValueOf(score).String(), 10, 30)
	ctx.Call("fillText", "Lives: "+js.ValueOf(lives).String(), 10, 60)
	if gameOver {
		ctx.Set("fillStyle", "red")
		ctx.Set("font", "40px sans-serif")
		ctx.Call("fillText", "GAME OVER", canvasWidth/2-120, canvasHeight/2)
	}
}

func gameLoop(this js.Value, args []js.Value) interface{} {
	defer func() {
		if r := recover(); r != nil {
			js.Global().Get("console").Call("error", "Panic in gameLoop:", r)
		}
	}()
	now := js.Global().Get("performance").Call("now").Float()
	if lastTime == 0 {
		lastTime = now
	}
	dt := (now - lastTime) / 1000.0
	if dt > 0.05 {
		dt = 0.05
	}
	lastTime = now
	update(dt)
	draw()
	js.Global().Call("requestAnimationFrame", loopFunc)
	return nil
}

func setupInput() {
	keyDown = js.FuncOf(func(this js.Value, args []js.Value) interface{} {
		e := args[0]
		key := e.Get("key").String()
		if key == "ArrowLeft" {
			paddle.vx = -450
		} else if key == "ArrowRight" {
			paddle.vx = 450
		}
		return nil
	})
	js.Global().Get("document").Call("addEventListener", "keydown", keyDown)

	keyUp = js.FuncOf(func(this js.Value, args []js.Value) interface{} {
		e := args[0]
		key := e.Get("key").String()
		if key == "ArrowLeft" || key == "ArrowRight" {
			paddle.vx = 0
		}
		return nil
	})
	js.Global().Get("document").Call("addEventListener", "keyup", keyUp)

	var lastX float64
	mouseMove = js.FuncOf(func(this js.Value, args []js.Value) interface{} {
		e := args[0]
		rect := canvas.Call("getBoundingClientRect")
		x := e.Get("clientX").Float() - rect.Get("left").Float()
		if x < 0 {
			x = 0
		}
		if x > canvasWidth-paddle.w {
			x = canvasWidth - paddle.w
		}
		if lastX != 0 {
			paddle.vx = (x - paddle.x) * 12
		}
		paddle.x = x
		lastX = x
		return nil
	})
	js.Global().Get("document").Call("addEventListener", "mousemove", mouseMove)

	mouseLeave = js.FuncOf(func(this js.Value, args []js.Value) interface{} {
		paddle.vx = 0
		return nil
	})
	js.Global().Get("document").Call("addEventListener", "mouseleave", mouseLeave)
}

func main() {
	defer func() {
		if r := recover(); r != nil {
			js.Global().Get("console").Call("error", "Panic in main:", r)
		}
	}()

	log("main: starting")
	canvas = doc.Call("getElementById", "gameCanvas")
	if canvas.IsNull() {
		log("canvas not found!")
		return
	}
	ctx = canvas.Call("getContext", "2d")
	if ctx.IsNull() {
		log("context not found!")
		return
	}
	log("canvas and context obtained")

	setupInput()
	resetGame()

	loopFunc = js.FuncOf(gameLoop)
	js.Global().Call("requestAnimationFrame", loopFunc)
	log("main: requestAnimationFrame called")

	select {}
}
